<Page
    x:Class="LumigramPlus.App.TopicsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="16,24,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock x:Name="ForumTitle" Text="forum" FontSize="14" Opacity="0.6"
                       TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="topics" FontSize="30"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="0,0,0,8">
            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" Opacity="0.7" FontSize="14"/>
        </StackPanel>

        <ListView x:Name="TopicList" Grid.Row="2"
                  SelectionMode="None" IsItemClickEnabled="True"
                  ItemClick="Topic_Click">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,8,0,8" Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>

                        <!--
                          The badge. Telegram draws a custom emoji here when the
                          topic has one, which needs the sticker machinery this
                          client does not have - so a coloured disc carrying the
                          first letter, in the colour the topic actually chose.
                          Recognisable at a glance in a list, which is the whole
                          job, without pretending to be the real icon.
                        -->
                        <Grid Grid.Column="0" Width="36" Height="36" Margin="0,0,12,0"
                              VerticalAlignment="Top">
                            <Ellipse Fill="{Binding IconBrush}"/>
                            <TextBlock Text="{Binding Initial}" Foreground="White"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>

                        <StackPanel Grid.Column="1">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="{Binding Title}"
                                           FontSize="{StaticResource AppListTitleFontSize}"
                                           TextTrimming="CharacterEllipsis"/>
                                <!-- A closed topic can still be read, so it is
                                     listed - but nothing can be said in it, and
                                     finding that out by typing a message first is
                                     the wrong order. -->
                                <TextBlock Text="closed" FontSize="12" Opacity="0.55"
                                           Margin="8,7,0,0"
                                           Visibility="{Binding ClosedVisibility}"/>
                            </StackPanel>
                            <TextBlock Text="{Binding Preview}" Opacity="0.6"
                                       FontSize="{StaticResource AppSubtleFontSize}"
                                       TextTrimming="CharacterEllipsis"/>
                        </StackPanel>

                        <Border Grid.Column="2" Visibility="{Binding UnreadVisibility}"
                                Background="{ThemeResource PhoneAccentBrush}"
                                CornerRadius="11" Padding="8,2,8,2" VerticalAlignment="Center">
                            <TextBlock Text="{Binding UnreadCount}" Foreground="White"
                                       FontSize="{StaticResource AppSubtleFontSize}"/>
                        </Border>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <!-- Same arrangement as the chat list: appending is separate from refresh,
             because refresh means reading the list again from the top and the two
             would otherwise fight. -->
        <Button x:Name="LoadMoreButton" Grid.Row="3" Content="load more topics"
                Click="LoadMore_Click" Visibility="Collapsed"
                HorizontalAlignment="Stretch" Margin="0,8,0,8"/>
    </Grid>

    <Page.BottomAppBar>
        <CommandBar>
            <AppBarButton Icon="Refresh" Label="refresh" Click="Refresh_Click"/>
        </CommandBar>
    </Page.BottomAppBar>
</Page>
