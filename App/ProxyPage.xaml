<Page
    x:Class="LumigramPlus.App.ProxyPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <Grid Margin="16,24,16,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0" Margin="0,0,0,8">
            <TextBlock Text="LUMIGRAM+" FontSize="14" Opacity="0.6"/>
            <TextBlock Text="SOCKS5 proxy" FontSize="30"/>
        </StackPanel>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"
                      HorizontalScrollMode="Disabled" Padding="0,0,0,16">
            <StackPanel>
                <TextBlock Text="For networks that block Telegram: every connection goes to the proxy, which passes it on to Telegram. Saving reconnects straight away and says whether it worked."
                           TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,0,0,8"/>

                <ToggleSwitch x:Name="EnabledSwitch" Header="Use a proxy"
                              OnContent="on" OffContent="off"/>

                <!-- No auto-capitalising or word suggestions in any of these: a
                     host name, a user name and a password are all exactly what was
                     typed, and a keyboard "correcting" one is a login that fails
                     for no visible reason. -->
                <TextBox x:Name="HostBox" Header="server" PlaceholderText="host name or IP address"
                         InputScope="Url" IsSpellCheckEnabled="False"
                         IsTextPredictionEnabled="False" Margin="0,8,0,0"/>

                <TextBox x:Name="PortBox" Header="port" PlaceholderText="1080"
                         InputScope="Number" Margin="0,8,0,0"/>

                <TextBox x:Name="UserBox" Header="username (if the proxy needs one)"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         Margin="0,8,0,0"/>

                <PasswordBox x:Name="PasswordBox" Header="password" Margin="0,8,0,0"/>

                <Button x:Name="SaveButton" Content="save and connect"
                        HorizontalAlignment="Stretch" Margin="0,16,0,0"
                        Click="Save_Click"/>

                <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"
                             Margin="0,8,0,0"/>
                <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="14"
                           Margin="0,8,0,0"/>

                <TextBlock Text="Calls are not sent through the proxy. They use a different kind of connection that SOCKS5 proxies of this sort do not carry, so a call goes directly."
                           TextWrapping="Wrap" Opacity="0.55" FontSize="12" Margin="0,16,0,0"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
