<Page
    x:Class="LumigramPlus.App.VideoCapturePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="Black">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!--
          The preview fills what is left. Stretch="UniformToFill" rather than
          "Uniform": a camera preview with black bars down the sides looks broken
          on a phone, and what is cropped is the edge of a frame nobody framed.
        -->
        <CaptureElement x:Name="Preview" Grid.Row="0" Stretch="UniformToFill"/>

        <StackPanel Grid.Row="0" VerticalAlignment="Top" Margin="16,24,16,0"
                    Orientation="Horizontal">
            <Ellipse Width="16" Height="16" Fill="Red" VerticalAlignment="Center"/>
            <TextBlock x:Name="ElapsedText" Text="0:00" Foreground="Red" FontSize="20"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
            <TextBlock x:Name="StatusText" Text="" Foreground="White" FontSize="16"
                       Margin="16,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Margin="16" Orientation="Horizontal"
                    HorizontalAlignment="Center">
            <Button x:Name="StopButton" Content="send" Click="Stop_Click"
                    MinWidth="140" Margin="0,0,16,0"/>
            <Button x:Name="CancelButton" Content="cancel" Click="Cancel_Click"
                    MinWidth="140"/>
        </StackPanel>
    </Grid>
</Page>
