<UserControl
    x:Class="LumigramPlus.App.ProxyPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- The proxy settings, shared by the "proxy" tab of the settings and by the
         proxy page that sign-in and tapped proxy links open. -->
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled"
                  HorizontalScrollBarVisibility="Disabled" Padding="0,0,0,16">
        <StackPanel>
            <TextBlock Text="For networks that block Telegram: every connection goes to the proxy, which passes it on to Telegram. Saving reconnects straight away and says whether it worked."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,0,0,8"/>

            <ToggleSwitch x:Name="EnabledSwitch" Header="Use a proxy"
                          OnContent="on" OffContent="off"/>

            <!-- A whole link is the easy way in: proxy lists publish them, and a
                 34-character secret is miserable to type on a phone keyboard. -->
            <TextBox x:Name="LinkBox" Header="proxy link (optional)"
                     PlaceholderText="https://t.me/proxy?server=..."
                     InputScope="Url" IsSpellCheckEnabled="False"
                     IsTextPredictionEnabled="False" TextWrapping="Wrap"
                     Margin="0,8,0,0"/>
            <Button x:Name="UseLinkButton" Content="fill in from the link"
                    HorizontalAlignment="Stretch" Margin="0,4,0,0"
                    Click="UseLink_Click"/>

            <!-- MTProto first: it is the default, and the type proxy lists share. -->
            <ComboBox x:Name="TypeBox" Header="type" Margin="0,12,0,0"
                      SelectionChanged="Type_SelectionChanged">
                <ComboBoxItem Content="MTProto"/>
                <ComboBoxItem Content="SOCKS5"/>
            </ComboBox>

            <!-- No auto-capitalising or word suggestions in any of these: a
                 host name, a user name, a secret and a password are all exactly
                 what was typed, and a keyboard "correcting" one is a login that
                 fails for no visible reason. -->
            <TextBox x:Name="HostBox" Header="server" PlaceholderText="host name or IP address"
                     InputScope="Url" IsSpellCheckEnabled="False"
                     IsTextPredictionEnabled="False" Margin="0,8,0,0"/>

            <TextBox x:Name="PortBox" Header="port" PlaceholderText="443"
                     InputScope="Number" Margin="0,8,0,0"/>

            <StackPanel x:Name="MtProtoPanel">
                <TextBox x:Name="SecretBox" Header="secret (hex or base64)"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         TextWrapping="Wrap" Margin="0,8,0,0"
                         TextChanged="Secret_TextChanged"/>
                <TextBlock x:Name="SecretTypeText" TextWrapping="Wrap" FontSize="13"
                           Opacity="0.7" Margin="0,4,0,0"/>
            </StackPanel>

            <StackPanel x:Name="SocksPanel" Visibility="Collapsed">
                <TextBox x:Name="UserBox" Header="username (if the proxy needs one)"
                         IsSpellCheckEnabled="False" IsTextPredictionEnabled="False"
                         Margin="0,8,0,0"/>

                <PasswordBox x:Name="PasswordBox" Header="password" Margin="0,8,0,0"/>
            </StackPanel>

            <Button x:Name="SaveButton" Content="save and connect"
                    HorizontalAlignment="Stretch" Margin="0,16,0,0"
                    Click="Save_Click"/>

            <ProgressBar x:Name="Busy" IsIndeterminate="True" Visibility="Collapsed"
                         Margin="0,8,0,0"/>
            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="14"
                       Margin="0,8,0,0"/>

            <TextBlock Text="Calls are not sent through the proxy. They use a different type of connection that these proxies do not carry, so a call goes directly."
                       TextWrapping="Wrap" Opacity="0.55" FontSize="12" Margin="0,16,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
