<?xml version="1.0" encoding="utf-8"?>
<Package xmlns="http://schemas.microsoft.com/appx/2010/manifest" xmlns:m2="http://schemas.microsoft.com/appx/2013/manifest" xmlns:m3="http://schemas.microsoft.com/appx/2014/manifest" xmlns:mp="http://schemas.microsoft.com/appx/2014/phone/manifest">
  <Identity Name="8f2b1c40-lumigramplus-0002" Publisher="CN=Lumigram" Version="1.0.30.1" />
  <mp:PhoneIdentity PhoneProductId="7B1C9D42-6E30-4A85-B2F9-1D40C8E5A736" PhonePublisherId="B1D9E4F0-2C7A-4E58-9F31-6A8D0C5B2E14" />
  <Properties>
    <DisplayName>Lumigram+ (WinRT)</DisplayName>
    <PublisherDisplayName>Lumigram</PublisherDisplayName>
    <Logo>Assets\StoreLogo.png</Logo>
  </Properties>
  <Prerequisites>
    <OSMinVersion>6.3.1</OSMinVersion>
    <OSMaxVersionTested>6.3.1</OSMaxVersionTested>
  </Prerequisites>
  <Resources>
    <Resource Language="en-US" />
  </Resources>
  <Applications>
    <Application Id="App" Executable="$targetnametoken$.exe" EntryPoint="LumigramPlus.App.App">
      <m3:VisualElements DisplayName="Lumigram+" Square150x150Logo="Assets\Square150x150Logo.png" Square44x44Logo="Assets\Square44x44Logo.png" Description="Telegram client for Windows Phone 8.1" ForegroundText="light" BackgroundColor="#0F7BC4" ToastCapable="true">
        <!--
          The brand blue, sampled from Art/logo.jpg rather than eyeballed.

          This is not only the app-list colour. A tile notification with a text
          template replaces the logo image entirely and draws on this, so while
          the tile was showing waiting chats it was grey - the one time anybody
          actually looks at it.
        -->
        <m3:DefaultTile Square71x71Logo="Assets\Square71x71Logo.png" Wide310x150Logo="Assets\Wide310x150Logo.png">
          <!-- Without this the tile is an unlabelled square. The small 71x71 tile
               has no room for a name and is not listed here. -->
          <m3:ShowNameOnTiles>
            <m3:ShowOn Tile="square150x150Logo" />
            <m3:ShowOn Tile="wide310x150Logo" />
          </m3:ShowNameOnTiles>
        </m3:DefaultTile>
        <!--
          The lock screen badge.

          badgeAndTileText rather than badge: badge alone offers the count for
          the quick status row, but only an app declaring tile text is offered in
          the detailed status slot at all. What it shows there is the wide tile's
          text - the waiting chats by name, not what they said.

          The image is a silhouette, not a picture - the lock screen keeps its alpha
          channel and draws the shape in the user's accent colour.

          Declaring this is not enough on its own: the user has to add the app under
          Settings, lock screen, choose apps to show quick status. Nothing appears
          until they do.
        -->
        <m3:LockScreen Notification="badgeAndTileText" BadgeLogo="Assets\BadgeLogo.png" />
        <m3:SplashScreen Image="Assets\SplashScreen.png" />
      </m3:VisualElements>
      <!--
        Background work, all of it behind one entry point.

        The quarter-hourly check, and nothing else.

        The entry point is a class in a Windows Runtime Component and the
        declaration names no executable. Both matter: the platform resolves the
        entry point as an activatable class, and only a component's classes are
        registered as such - while naming an executable is the Windows 10
        in-process model, which this phone refuses.

        A controlChannel task was declared here three times, in every shape the
        build would accept, and each one stopped the package installing. The
        deployment error says only "could not be registered", so what the system
        objected to was never established. It is gone rather than left in: an
        extension that will not install costs the whole app, not just its feature.
      -->
      <Extensions>
        <Extension Category="windows.backgroundTasks" EntryPoint="LumigramPlus.Tasks.NotificationTask">
          <BackgroundTasks>
            <Task Type="timer" />
          </BackgroundTasks>
        </Extension>
      </Extensions>
    </Application>
  </Applications>
  <Capabilities>
    <Capability Name="internetClientServer" />
    <Capability Name="picturesLibrary" />
    <DeviceCapability Name="microphone" />
    <!-- Saving a picture into the gallery. Without it KnownFolders.SavedPictures
         is simply not there, and the copy fails at runtime rather than at build. -->
    <!-- Without this MediaCapture refuses to initialise at all, with an access
         denied that says nothing about which permission is missing. -->
  </Capabilities>
</Package>