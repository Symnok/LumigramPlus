<Page
    x:Class="LumigramPlus.App.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource ApplicationPageBackgroundThemeBrush}">

    <!--
      Two tabs, swiped between: the settings, and what this app is.

      A Pivot because that is what a tab is on this platform - the same swipeable
      headings as the phone's own settings and mail. Its title takes the place of
      the "LUMIGRAM+" line the page used to draw for itself, and the tab headings
      take the place of the page heading.
    -->
    <Pivot x:Name="Tabs" Title="LUMIGRAM+">
        <PivotItem Header="settings">
        <!--
          The settings outgrew the screen the moment background notifications
          arrived, and a StackPanel does not scroll on its own - it is simply given
          the height it asks for and the rest is off the bottom of the phone.
        -->
        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      VerticalScrollMode="Enabled" HorizontalScrollMode="Disabled"
                      HorizontalScrollBarVisibility="Disabled"
                      Padding="0,0,0,16">
        <StackPanel>
            <TextBlock Text="Text size" Margin="0,0,0,4"/>
            <ComboBox x:Name="TextSizeBox" HorizontalAlignment="Stretch"
                      SelectionChanged="TextSize_Changed">
                <ComboBoxItem Content="extra small"/>
                <ComboBoxItem Content="small"/>
                <ComboBoxItem Content="medium"/>
                <ComboBoxItem Content="large"/>
                <ComboBoxItem Content="extra large"/>
            </ComboBox>
            <TextBlock Text="Applies to messages and the chat list. Small is the size the app used before this setting existed. Each screen picks up a change the next time it is opened."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,0"/>

            <ToggleSwitch x:Name="AutoLoadSwitch" Header="Download photos automatically"
                          Margin="0,20,0,0"
                          OnContent="on" OffContent="off"
                          Toggled="AutoLoad_Toggled"/>
            <TextBlock Text="Off means photos are fetched only when tapped, which is worth having on a metered connection."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,0"/>

            <ToggleSwitch x:Name="NotificationsSwitch" Header="Notifications"
                          OnContent="on" OffContent="off"
                          Toggled="Notifications_Toggled" Margin="0,16,0,0"/>
            <TextBlock Text="Announces messages while the app is open. Muted chats never notify, and neither does the chat you are reading."
                       TextWrapping="Wrap" Opacity="0.7" FontSize="13" Margin="0,4,0,0"/>

            <ToggleSwitch x:Name="SoundSwitch" Header="Notification sound"
                          OnContent="on" OffContent="off"
                          Toggled="Sound_Toggled" Margin="0,16,0,0"/>

            <TextBlock Text="Notifications in background" Margin="0,20,0,4"/>
            <ComboBox x:Name="BackgroundBox" HorizontalAlignment="Stretch"
                      SelectionChanged="Background_Changed">
                <ComboBoxItem Content="off"/>
                <ComboBoxItem Content="every 15 minutes"/>
            </ComboBox>
            <TextBlock x:Name="BackgroundText" Text="" TextWrapping="Wrap" Opacity="0.7"
                       FontSize="13" Margin="0,4,0,0"/>

            <Button x:Name="CheckNowButton" Content="check for messages now"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    Click="CheckNow_Click"/>
            <TextBlock x:Name="LastRunText" Text="" TextWrapping="Wrap" Opacity="0.7"
                       FontSize="13" Margin="0,4,0,0"/>

            <Button x:Name="BenchmarkButton" Content="voice codec benchmark"
                    HorizontalAlignment="Stretch" Margin="0,20,0,0"
                    Click="Benchmark_Click"/>
            <TextBlock x:Name="BenchmarkText" Text="" TextWrapping="Wrap" Opacity="0.7"
                       FontSize="12" FontFamily="Consolas" Margin="0,4,0,0"/>

            <TextBlock x:Name="CallText" Text="" TextWrapping="Wrap" Opacity="0.7"
                       FontSize="12" FontFamily="Consolas" Margin="0,20,0,0"/>

            <TextBlock x:Name="ToastText" Text="" TextWrapping="Wrap" Opacity="0.7"
                       FontSize="13" Margin="0,4,0,0"/>

            <!-- Whether this phone's emoji font can draw every reaction on offer.
                 Checked here rather than assumed, because the font is older than
                 most of Telegram's reactions and there is no way to ask it. -->
            <TextBlock Text="Reaction test" Margin="0,28,0,4"/>
            <TextBlock x:Name="ReactionTestText" TextWrapping="Wrap"
                       IsColorFontEnabled="True" FontSize="26"/>
            <TextBlock Text="The reactions on offer, numbered. If any shows as an empty box, or the heart is black, say its number and it will be taken out."
                       TextWrapping="Wrap" Opacity="0.55" FontSize="12" Margin="0,4,0,0"/>

            <TextBlock Text="Downloaded files" Margin="0,28,0,4"/>
            <TextBlock x:Name="CacheText" Text="" TextWrapping="Wrap" Opacity="0.7"
                       FontSize="13"/>

            <!-- Above the sign-out and exit pair rather than among them: those two
                 end something, and this one only reclaims room. -->
            <Button x:Name="ClearCacheButton" Content="delete downloaded files"
                    HorizontalAlignment="Stretch" Margin="0,8,0,0"
                    Click="ClearCache_Click"/>
            <TextBlock Text="Photos, videos and files already fetched, and the chat pictures. Every one of them can be fetched again, nothing is removed from Telegram, and the sign-in is untouched."
                       TextWrapping="Wrap" Opacity="0.55" FontSize="12" Margin="0,4,0,0"/>

            <TextBlock x:Name="AccountText" Text="" TextWrapping="Wrap" Opacity="0.7"
                       FontSize="13" Margin="0,28,0,4"/>

            <Button Content="sign out" Click="SignOut_Click"
                    HorizontalAlignment="Stretch"/>
            <TextBlock Text="Forgets the authorisation on this phone. The session stays listed under Devices in Telegram until removed there."
                       TextWrapping="Wrap" Opacity="0.55" FontSize="12" Margin="0,4,0,12"/>

            <Button Content="exit" Click="Exit_Click" HorizontalAlignment="Stretch"/>
        </StackPanel>
        </ScrollViewer>
        </PivotItem>

        <PivotItem Header="about">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollMode="Disabled" Padding="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Lumigram+" FontSize="34"/>

                    <!-- Read from the installed package rather than written here, so
                         it cannot fall out of step with the build: this is the
                         number to quote when something goes wrong. -->
                    <TextBlock x:Name="VersionText" FontSize="22" Opacity="0.85"
                               Margin="0,2,0,0"/>

                    <TextBlock Text="Telegram client for Windows Phone 8.1"
                               TextWrapping="Wrap" FontSize="16" Margin="0,16,0,0"/>

                    <TextBlock Text="Talks to Telegram's servers directly over MTProto 2.0. There is no server of ours in between, and the sign-in key is made on this phone and never leaves it."
                               TextWrapping="Wrap" Opacity="0.7" FontSize="14"
                               Margin="0,8,0,0"/>

                    <TextBlock x:Name="LayerText" Opacity="0.55" FontSize="13"
                               Margin="0,16,0,0"/>

                    <HyperlinkButton Content="github.com/Symnok/LumigramPlus"
                                     NavigateUri="https://github.com/Symnok/LumigramPlus"
                                     Margin="-12,12,0,0" FontSize="15"/>

                    <TextBlock Text="MIT License, &#169; 2026 Symnok"
                               Opacity="0.55" FontSize="13" Margin="0,4,0,0"/>
                </StackPanel>
            </ScrollViewer>
        </PivotItem>
    </Pivot>
</Page>
